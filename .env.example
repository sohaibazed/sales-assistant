# ── Model providers ───────────────────────────────────────────────────────────
# Any provider init_chat_model supports. At least one key is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── LangSmith: tracing, Studio, datasets & experiments ────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sales-assistant

# ── Models ("provider:model"; defaults shown are what config.py picks with an OpenAI key) ──
# MAIN_MODEL=openai:gpt-5.4           # plans, delegates, writes deliverables, performs gated actions
# SUBAGENT_MODEL=openai:gpt-4.1-mini  # the four specialists (fast, cheap)
# FALLBACK_MODEL=openai:gpt-4.1-mini  # used automatically when MAIN_MODEL errors
# JUDGE_MODEL=openai:gpt-5.5          # LLM-as-judge for evals (use a different model than the agent)
#
# Anthropic equivalents:
# MAIN_MODEL=anthropic:claude-sonnet-4-6
# SUBAGENT_MODEL=anthropic:claude-haiku-4-5

# ── Integrations ──────────────────────────────────────────────────────────────
# The mail MCP server (started by ./start.sh). Point this at a real mail MCP server to go live.
MAIL_MCP_URL=http://127.0.0.1:8765/mcp
# MAIL_MCP_PORT=8765
# Optional: live web search for the genre-researcher (pip install langchain-tavily). Without
# it, web_search answers from a small offline corpus and says so.
# TAVILY_API_KEY=
# Vendor payments at or above this amount pause for human approval (smaller ones auto-pay).
PAY_APPROVAL_THRESHOLD=1000
