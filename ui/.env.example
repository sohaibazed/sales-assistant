# Chinook Sales Assistant UI (fork of langchain-ai/agent-chat-ui).
# Agent Server started by ../start.sh (langgraph dev).
NEXT_PUBLIC_API_URL=http://localhost:2024
# The graph id from ../langgraph.json.
NEXT_PUBLIC_ASSISTANT_ID=sales_assistant
# Only for a deployed Agent Server behind the /api proxy; not needed for langgraph dev.
LANGSMITH_API_KEY=
